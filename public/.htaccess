<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Staging asks for a name and a password. Production does not. ────────────
#
# The switch is the password file itself (ADR-0080): where it exists the whole
# site is closed, and where it does not — production — Apache skips these lines
# without reading them. So the protection survives `git pull`, which is the one
# thing a hand-edit on the server does not.
<IfFile "/usr/www/users/dvpjdhdo/.htpasswd">

    # A password is asked for everything except four openings, matched on the
    # raw request line:
    #
    #   /.well-known/       the certificate renews over HTTP-01 in December
    #   /api/student/       the competitor SPA sends `Authorization: Bearer`,
    #                       which REPLACES Basic — every exam call would be 401
    #   /manifest.webmanifest and /storage/branding/
    #                       a browser fetches both without credentials, and
    #                       without both of them it offers no install (ADR-0073)
    #
    # 🪤 THE_REQUEST, not REQUEST_URI: the front-controller rule above rewrites
    # the path to `index.php` and authorisation is settled over the *rewritten*
    # one, so REQUEST_URI reads `/index.php` for every request that matters.
    #
    # 🪤 And `<If>`, not `SetEnvIf`: THE_REQUEST is a variable of mod_rewrite and
    # of the expression parser, and is not one of the attribute names SetEnvIf
    # knows. A name SetEnvIf does not recognise it looks for among the request
    # *headers* — so `SetEnvIf THE_REQUEST` matches nothing, quietly, and every
    # opening stays shut. Measured on the server, not reasoned about.
    #
    # 🔴 The second half of the condition asks for the password back the moment
    # the request line could walk out of the prefix it was let in by:
    # `GET /api/student/../../login` matches the opening and is served from
    # somewhere else entirely. An opening is only as narrow as the path that
    # cannot escape it.
    <If "%{THE_REQUEST} !~ m#^[A-Z]+ /(\.well-known/|api/student/|manifest\.webmanifest|storage/branding/)# || %{THE_REQUEST} =~ m#(\.\.|%2e|%2f|%5c)#i">
        AuthType Basic
        AuthName "SOA HTC staging"
        AuthUserFile "/usr/www/users/dvpjdhdo/.htpasswd"
        Require valid-user
    </If>
</IfFile>
