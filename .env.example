# The file a deployment starts from: `composer setup` copies it to `.env` when
# there is none. Its defaults are therefore PRODUCTION defaults — copy it
# without reading it and you get a closed installation rather than an open one.
# Setting up for development instead means turning a handful of these around;
# they are listed in `docs/06_DEPLOYMENT.md` under "Setting up for development".

APP_NAME="SOA HTC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://soa-htc.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# No credentials here on purpose: an empty user cannot connect, so a database
# nobody configured announces itself on the first command instead of quietly
# turning out to be somebody else's.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soa_htc
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sends the session cookie over HTTPS only. A site served over plain HTTP then
# cannot sign anybody in — which is the right answer, not a fault to work around.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Coordinator registration answers by e-mail, twice, so this has to be a real
# mailer before the doors open — the log driver would swallow both messages.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@soa-htc.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hosts whose browser session the API trusts. One entry is one host allowed to
# act as a signed-in user, so this is the live site and nothing else.
SANCTUM_STATEFUL_DOMAINS=soa-htc.org
